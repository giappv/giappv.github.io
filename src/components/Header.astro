---
// Menu order follows a visitor's questions: what is Giap doing now (Now) → what has Giap said (Talks)
// → what has Giap built (Work) → how did Giap get here (Career) → how do I get in touch (Contact).
// New items go where they answer their question in that journey, not at the end.
const nav = [
  { href: '/#now', label: 'Now' },
  { href: '/#talks', label: 'Talks' },
  { href: '/#work', label: 'Work' },
  { href: '/#career', label: 'Career' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label="Phan Vu Giap home">
      <span class="mark" aria-hidden="true">PG</span>
      <span class="wordmark">Phan Vu Giap</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {nav.map((item) => <li><a href={item.href} aria-current={item.href === Astro.url.pathname ? 'page' : undefined}>{item.label}</a></li>)}
      </ul>
    </nav>
    <button class="theme-toggle" type="button" aria-label="Switch to dark theme" data-theme-toggle>
      <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
      <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
    </button>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;
  const sync = () => {
    const dark = root.dataset.theme === 'dark';
    button?.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
  };
  sync();
  button?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('bh-theme', next);
    } catch {}
    sync();
  });
</script>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: var(--bh-z-index-sticky);
    background: var(--bh-color-surface-page);
    border-block-end: var(--bh-border-width-default) solid var(--bh-color-border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--bh-space-300);
    min-block-size: var(--bh-layout-header-height);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--bh-space-100);
    color: var(--bh-color-text);
    text-decoration: none;
    font: var(--bh-font-heading-xsmall);
  }
  .mark {
    display: inline-grid;
    place-items: center;
    inline-size: var(--bh-size-control-default);
    block-size: var(--bh-size-control-default);
    border-radius: var(--bh-radius-control);
    background: var(--bh-color-background-brand-bold);
    color: var(--bh-color-text-on-brand);
    font: var(--bh-font-label-default);
    font-weight: var(--bh-font-weight-bold);
  }
  nav {
    margin-inline-start: auto;
  }
  nav ul {
    display: flex;
    gap: var(--bh-space-050);
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--bh-size-control-default);
    padding-inline: var(--bh-space-control-x);
    border-radius: var(--bh-radius-control);
    color: var(--bh-color-text-subtle);
    text-decoration: none;
    font: var(--bh-font-label-default);
    transition: background-color var(--bh-motion-control), color var(--bh-motion-control);
  }
  nav a:hover {
    background: var(--bh-button-background-subtle-hover);
    color: var(--bh-color-text);
  }
  nav a[aria-current='page'] {
    color: var(--bh-color-text);
    background: var(--bh-button-background-subtle-hover);
  }
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    inline-size: var(--bh-size-control-default);
    block-size: var(--bh-size-control-default);
    border: var(--bh-border-width-default) solid var(--bh-color-border);
    border-radius: var(--bh-radius-control);
    background: var(--bh-color-surface);
    color: var(--bh-color-icon);
    cursor: pointer;
    transition: background-color var(--bh-motion-control), border-color var(--bh-motion-control);
  }
  .theme-toggle:hover {
    background: var(--bh-button-background-subtle-hover);
    border-color: var(--bh-color-border-hover);
  }
  .theme-toggle svg {
    inline-size: var(--bh-size-icon-default);
    block-size: var(--bh-size-icon-default);
  }
  .icon-sun,
  :global([data-theme='dark']) .icon-moon {
    display: none;
  }
  :global([data-theme='dark']) .icon-sun {
    display: block;
  }
  @media (max-width: 47.99rem) {
    nav {
      display: none;
    }
    .theme-toggle {
      margin-inline-start: auto;
    }
  }
</style>
