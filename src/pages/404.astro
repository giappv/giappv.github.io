---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Page not found | Phan Vu Giap" description="This page doesn't exist.">
  <Header />
  <main id="main" class="section">
    <div class="container measure">
      <div class="section-head">
        <span class="eyebrow">404</span>
        <h1>Page not found</h1>
        <p>The page you were looking for has moved or never existed.</p>
      </div>
      <a class="button button--primary" href="/">Back to home</a>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  h1 {
    font: var(--bh-font-heading-xlarge);
  }
</style>
